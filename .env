# Environment Configuration for AI-Driven Infrastructure Capacity Planning Advisor (Template)

# API Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM & Vector Store Settings (RAG & LangGraph Agents)
# LLM Provider selection: "gemini" or "litellm"
LLM_PROVIDER=gemini

# LiteLLM Configuration (TCS GenAI Lab API)
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_API_BASE=https://genailab.tcs.in/v1
LITELLM_MODEL=gemini-2.0-flash
LITELLM_PROJECT_ID=your_project_id_here
LITELLM_CLIENT_ID=your_client_id_here
# Optional JSON string of extra request headers (e.g. {"custom-auth": "val"})
LITELLM_HEADERS=
LITELLM_VERIFY_SSL=false

# Google Gemini Configuration
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# LLM Gateway Timeout in seconds
LLM_TIMEOUT=12.0

# MCP Database Configuration
MCP_DB_PATH=./data/capacity_planner.db

# RAG Vector DB Path
CHROMA_PERSIST_DIR=./data/chroma_db

# Financial Cost Model Rates (USD per unit per day)
CPU_RATE=0.05
MEMORY_RATE=0.02
STORAGE_RATE=0.01

# System Thresholds & Metric Targets
ACCURACY_TARGET_PCT=80.0
COST_SAVINGS_TARGET=20.0
CPU_SLA_LIMIT=85.0
MEMORY_SLA_LIMIT=90.0
