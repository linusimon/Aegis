# ===================================================================
# Aegis AI - Git Ignore Rules
# ===================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache Directories
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js & Angular Frontend Dependencies & Builds
frontend/node_modules/
node_modules/
frontend/dist/
frontend/.angular/
frontend/.nx/
.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables, Keys & Secrets (.env is allowed per user directive)
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.pfx

# SQLite Databases & Local Vector Storage (.db is allowed per user directive)
data/chroma_db/

# Logs & Temporary Files
*.log
*.tmp
*.temp

# IDE & Editor Directories
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
